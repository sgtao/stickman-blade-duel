#!/bin/sh
# git push の前に、検査と生成物の一致を確かめる。不合格なら push を止める。
# 有効化は clone ごとに一度だけ：git config core.hooksPath .githooks
# index.html は生成物。ここでは再生成して HEAD と比べるだけで、何も commit しない。
set -e
cd "$(git rev-parse --show-toplevel)"

echo "== push 前の検査 1/2：index.html が src/ と一致するか"
node build.mjs
if ! git diff --exit-code HEAD -- index.html >/dev/null; then
  echo "index.html が src/ と食い違う。node build.mjs の結果を commit してから push する" >&2
  exit 1
fi

echo "== push 前の検査 2/2：全 8 本（性能の検査を含む）"
NODE_PATH=$(npm root -g) node tests/run_all.mjs
